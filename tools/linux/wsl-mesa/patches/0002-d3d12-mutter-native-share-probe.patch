+#ifndef D3D12_MUTTER_SHARE_PROBE_H
+#define D3D12_MUTTER_SHARE_PROBE_H
+
+struct d3d12_context;
+
+/* Returns true when a copy was recorded in the current command list. */
+bool d3d12_mutter_share_probe_record(struct d3d12_context *ctx);
+
+/* Called after d3d12_flush_cmdlist() submits the list containing the copy. */
+void d3d12_mutter_share_probe_publish(struct d3d12_context *ctx);
+
+void d3d12_mutter_share_probe_destroy(struct d3d12_context *ctx);
+
+#endif
