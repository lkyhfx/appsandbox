+namespace {
+
+constexpr uint32_t kMagic = 0x41534433;
+constexpr uint32_t kResourceBundle = 1;
+constexpr uint32_t kConsumerReady = 2;
+constexpr uint32_t kFrameInfo = 3;
+constexpr uint32_t kSlotCount = 3;
+/* Production dimensions come from the actual Mutter render target. */
+constexpr int kPollTimeoutMs = 0;
+constexpr int kDiagnosticTimeoutMs = 10000;
+
+enum class CopyProbeMode {
+   None,
+   Invalid,
+   RingOnly,
+   BarrierOnly,
+   LocalCopy,
+   SharedCopyNoConsumer,
+   SharedCopyConsumer,
+   PostflushLocalCopy,
+   PostflushSharedCopyNoConsumer,
+   PostflushSharedCopyConsumer,
+};
+
+struct ResourceBundle {
+   uint32_t magic, type, width, height, slots, frames;
+   uint32_t format, synthetic_source, gpu_copy, buffer_count;
+};
+struct ConsumerReady {
+   uint32_t magic, type, status, opened_resources, done_eventfds;
+};
+struct FrameInfo {
+   uint32_t magic, type;
+   uint64_t frame;
+   uint32_t slot, diagnostic;
+   uint64_t producer_signal_ns;
+   uint8_t expected_r, expected_g, expected_b, expected_a;
+   uint32_t expected_valid;
+};
+static_assert(sizeof(ResourceBundle) == 40, "share ABI");
+static_assert(sizeof(ConsumerReady) == 20, "share ABI");
+static_assert(sizeof(FrameInfo) == 40, "share ABI");
+
+struct Slot {
+   ComPtr<ID3D12Resource> resource;
+   int resource_fd = -1;
+   int ready_fd = -1;
+   int done_fd = -1;
+
+   /* Post-flush capture objects are never Mesa's allocator or command list. */
+   ComPtr<ID3D12CommandAllocator> allocator;
+   ComPtr<ID3D12GraphicsCommandList> command_list;
+   ComPtr<ID3D12Resource> source_keepalive;
+   uint64_t capture_fence_value = 0;
+   bool submitted = false;
+};
+
+struct PendingCapture {
+   ComPtr<ID3D12Resource> source;
+   D3D12_RESOURCE_DESC source_desc = {};
+   uint32_t slot = 0;
+   bool valid = false;
+};
+
+struct AppsandboxShare {
+   int socket_fd = -1;
+   std::array<Slot, kSlotCount> slots;
+   ComPtr<ID3D12Fence> fence;
+   uint64_t frame = 0;
+   uint32_t pending_slot = 0;
+   ID3D12Resource *last_source = nullptr;
+   uint64_t source_resource_changes = 0;
+   uint64_t copy_start_ns = 0;
+   std::vector<uint64_t> gpu_copy_us;
+   std::vector<uint64_t> slot_recycle_us;
+   ComPtr<ID3D12Resource> diagnostic_destination;
+   ComPtr<ID3D12Fence> diagnostic_fence;
+   ComPtr<ID3D12Fence> capture_fence;
+   uint64_t next_capture_fence_value = 0;
+   PendingCapture pending_capture;
+   ComPtr<ID3D12Resource> postflush_destination;
+   int postflush_resource_fd = -1;
+   int postflush_event_fd = -1;
+   uint32_t postflush_slot = 0;
+   bool postflush_submitted = false;
+   int diagnostic_resource_fd = -1;
+   int diagnostic_event_fd = -1;
+   uint64_t diagnostic_value = 0;
+   CopyProbeMode probe_mode = CopyProbeMode::None;
+   bool diagnostic_pending = false;
+   bool diagnostic_done = false;
+   bool initialized = false;
+   bool pending = false;
+};
+
+static bool hook_logged = false;
+static bool empty_hook_logged = false;
+static bool ensure_logged = false;
+static bool invalid_probe_logged = false;
+
+static CopyProbeMode copy_probe_mode()
+{
+   const char *value = getenv("ASB_D3D12_COPY_PROBE");
+   if (!value || !value[0])
+      return CopyProbeMode::None;
+   if (!strcmp(value, "ring-only"))
+      return CopyProbeMode::RingOnly;
+   if (!strcmp(value, "barrier-only"))
+      return CopyProbeMode::BarrierOnly;
+   if (!strcmp(value, "local-copy"))
+      return CopyProbeMode::LocalCopy;
+   if (!strcmp(value, "shared-copy-no-consumer"))
+      return CopyProbeMode::SharedCopyNoConsumer;
+   if (!strcmp(value, "shared-copy-consumer") ||
+       !strcmp(value, "shared-copy+consumer"))
+      return CopyProbeMode::SharedCopyConsumer;
+   if (!strcmp(value, "postflush-local-copy"))
+      return CopyProbeMode::PostflushLocalCopy;
+   if (!strcmp(value, "postflush-shared-copy-no-consumer"))
+      return CopyProbeMode::PostflushSharedCopyNoConsumer;
+   if (!strcmp(value, "postflush-shared-copy-consumer"))
+      return CopyProbeMode::PostflushSharedCopyConsumer;
+   return CopyProbeMode::Invalid;
+}
+
+static bool is_postflush_probe(CopyProbeMode mode)
+{
+   return mode == CopyProbeMode::PostflushLocalCopy ||
+          mode == CopyProbeMode::PostflushSharedCopyNoConsumer ||
+          mode == CopyProbeMode::PostflushSharedCopyConsumer;
+}
+
+static bool postflush_needs_consumer(CopyProbeMode mode)
+{
+   return mode == CopyProbeMode::PostflushSharedCopyConsumer;
+}
+
+static const char *copy_probe_mode_name(CopyProbeMode mode)
+{
+   switch (mode) {
+   case CopyProbeMode::Invalid: return "invalid";
+   case CopyProbeMode::RingOnly: return "ring-only";
+   case CopyProbeMode::BarrierOnly: return "barrier-only";
+   case CopyProbeMode::LocalCopy: return "local-copy";
+   case CopyProbeMode::SharedCopyNoConsumer: return "shared-copy-no-consumer";
+   case CopyProbeMode::SharedCopyConsumer: return "shared-copy-consumer";
+   case CopyProbeMode::PostflushLocalCopy: return "postflush-local-copy";
+   case CopyProbeMode::PostflushSharedCopyNoConsumer:
+      return "postflush-shared-copy-no-consumer";
+   case CopyProbeMode::PostflushSharedCopyConsumer:
+      return "postflush-shared-copy-consumer";
+   case CopyProbeMode::None: break;
+   }
+   return "none";
+}
+
+static uint64_t now_ns()
+{
+   struct timespec ts = {};
+   clock_gettime(CLOCK_MONOTONIC, &ts);
+   return static_cast<uint64_t>(ts.tv_sec) * 1000000000ULL + ts.tv_nsec;
+}
+
+static double percentile_us(const std::vector<uint64_t> &values, double q)
+{
+   if (values.empty())
+      return 0.0;
+   std::vector<uint64_t> sorted = values;
+   std::sort(sorted.begin(), sorted.end());
+   const size_t index = static_cast<size_t>(q * (sorted.size() - 1));
+   return static_cast<double>(sorted[index]) / 1000.0;
+}
+
+static void close_fd(int &fd)
+{
+   if (fd >= 0)
+      close(fd);
+   fd = -1;
+}
+
+static bool send_fds(int fd, const void *data, size_t size,
+                     const std::vector<int> &fds)
+{
+   struct msghdr msg = {};
+   struct iovec iov = {const_cast<void *>(data), size};
+   msg.msg_iov = &iov;
+   msg.msg_iovlen = 1;
+   std::array<unsigned char, CMSG_SPACE(sizeof(int) * 6)> control = {};
+   if (!fds.empty()) {
+      msg.msg_control = control.data();
+      msg.msg_controllen = CMSG_SPACE(sizeof(int) * fds.size());
+      struct cmsghdr *cmsg = CMSG_FIRSTHDR(&msg);
+      cmsg->cmsg_level = SOL_SOCKET;
+      cmsg->cmsg_type = SCM_RIGHTS;
+      cmsg->cmsg_len = CMSG_LEN(sizeof(int) * fds.size());
+      memcpy(CMSG_DATA(cmsg), fds.data(), sizeof(int) * fds.size());
+   }
+   return sendmsg(fd, &msg, MSG_NOSIGNAL) == static_cast<ssize_t>(size);
+}
+
+static bool recv_fds(int fd, void *data, size_t size, std::vector<int> &fds)
+{
+   struct msghdr msg = {};
+   struct iovec iov = {data, size};
+   msg.msg_iov = &iov;
+   msg.msg_iovlen = 1;
+   std::array<unsigned char, CMSG_SPACE(sizeof(int) * 6)> control = {};
+   msg.msg_control = control.data();
+   msg.msg_controllen = control.size();
+   const ssize_t got = recvmsg(fd, &msg, 0);
+   if (got != static_cast<ssize_t>(size) || (msg.msg_flags & MSG_CTRUNC))
+      return false;
+   for (struct cmsghdr *cmsg = CMSG_FIRSTHDR(&msg); cmsg;
+        cmsg = CMSG_NXTHDR(&msg, cmsg)) {
+      if (cmsg->cmsg_level != SOL_SOCKET || cmsg->cmsg_type != SCM_RIGHTS)
+         continue;
+      const size_t bytes = cmsg->cmsg_len - CMSG_LEN(0);
+      if (bytes % sizeof(int) != 0)
+         return false;
+      const int *received = reinterpret_cast<const int *>(CMSG_DATA(cmsg));
+      for (size_t i = 0; i < bytes / sizeof(int); ++i)
+         fds.push_back(received[i]);
+   }
+   return true;
+}
+
+static bool try_done(int fd, uint64_t *wait_us)
+{
+   const uint64_t start_ns = now_ns();
+   struct pollfd pfd = {fd, POLLIN, 0};
+   int result;
+   do
+      result = poll(&pfd, 1, kPollTimeoutMs);
+   while (result < 0 && errno == EINTR);
+   if (result <= 0 || !(pfd.revents & POLLIN))
+      return false;
+   eventfd_t value = 0;
+   const bool ok = eventfd_read(fd, &value) == 0 && value != 0;
+   if (ok && wait_us)
+      *wait_us = (now_ns() - start_ns) / 1000;
+   return ok;
+}
+
+static bool set_completion(ID3D12Fence *fence, uint64_t value, int fd)
+{
+   return SUCCEEDED(fence->SetEventOnCompletion(
+      value, reinterpret_cast<HANDLE>(static_cast<intptr_t>(fd))));
+}
+
+static bool wait_capture_event(int fd, int timeout_ms)
+{
+   struct pollfd pfd = {fd, POLLIN, 0};
+   int result;
+   do
+      result = poll(&pfd, 1, timeout_ms);
+   while (result < 0 && errno == EINTR);
+   if (result <= 0 || !(pfd.revents & POLLIN))
+      return false;
+   eventfd_t value = 0;
+   return eventfd_read(fd, &value) == 0 && value != 0;
+}
+
+static void log_postflush_source(struct d3d12_resource *source,
+                                  CopyProbeMode mode, bool destination_shared)
+{
+   ID3D12Resource *resource = d3d12_resource_resource(source);
+   const D3D12_RESOURCE_DESC desc = resource->GetDesc();
+   D3D12_HEAP_PROPERTIES heap = {};
+   D3D12_HEAP_FLAGS heap_flags = D3D12_HEAP_FLAG_NONE;
+   const HRESULT heap_hr = resource->GetHeapProperties(&heap, &heap_flags);
+   fprintf(stderr,
+           "ASB_D3D12 postflush_probe mode=%s source=%p "
+           "source_dimension=%u source_width=%llu source_height=%u "
+           "source_depth_or_array=%u source_mips=%u source_format=%u "
+           "source_sample_count=%u source_sample_quality=%u "
+           "source_layout=%u source_flags=0x%08x "
+           "source_heap_type=%u source_heap_flags=0x%08x "
+           "source_heap_hr=0x%08x destination shared=%u destination_shared=%u\n",
+           copy_probe_mode_name(mode), resource, static_cast<unsigned>(desc.Dimension),
+           static_cast<unsigned long long>(desc.Width), desc.Height,
+           desc.DepthOrArraySize, desc.MipLevels, static_cast<unsigned>(desc.Format),
+           desc.SampleDesc.Count, desc.SampleDesc.Quality, static_cast<unsigned>(desc.Layout),
+           static_cast<unsigned>(desc.Flags), static_cast<unsigned>(heap.Type),
+           static_cast<unsigned>(heap_flags), static_cast<unsigned>(heap_hr),
+           destination_shared ? 1U : 0U, destination_shared ? 1U : 0U);
+   fflush(stderr);
+}
+
+static bool postflush_source_supported(struct d3d12_resource *source)
+{
+   const D3D12_RESOURCE_DESC desc = d3d12_resource_resource(source)->GetDesc();
+   return desc.Dimension == D3D12_RESOURCE_DIMENSION_TEXTURE2D &&
+          desc.Width > 0 && desc.Height > 0 && desc.Width <= 16384 &&
+          desc.Height <= 16384 && desc.SampleDesc.Count == 1 &&
+          (desc.Format == DXGI_FORMAT_R8G8B8A8_UNORM ||
+           desc.Format == DXGI_FORMAT_B8G8R8A8_UNORM);
+}
+
+static void log_postflush_failure(struct d3d12_context *ctx,
+                                   AppsandboxShare *share,
+                                   const char *stage)
+{
+   const HRESULT removed_reason =
+      d3d12_screen(ctx->base.screen)->dev->GetDeviceRemovedReason();
+   fprintf(stderr, "ASB_D3D12 postflush_probe mode=%s stage=%s "
+                "capture_submit=fail capture_completion=timeout "
+                "removed_reason=0x%08x\n",
+           copy_probe_mode_name(share->probe_mode), stage,
+           static_cast<unsigned>(removed_reason));
+}
+
+static bool ensure_diagnostic_destination(struct d3d12_context *ctx,
+                                           struct d3d12_resource *source,
+                                           AppsandboxShare *share,
+                                           bool shared)
+{
+   if (share->diagnostic_destination)
+      return true;
+   struct d3d12_screen *screen = d3d12_screen(ctx->base.screen);
+   const D3D12_RESOURCE_DESC desc =
+      d3d12_resource_resource(source)->GetDesc();
+   D3D12_HEAP_PROPERTIES heap = {};
+   heap.Type = D3D12_HEAP_TYPE_DEFAULT;
+   heap.CreationNodeMask = 1;
+   heap.VisibleNodeMask = 1;
+   const D3D12_HEAP_FLAGS flags =
+      shared ? D3D12_HEAP_FLAG_SHARED : D3D12_HEAP_FLAG_NONE;
+   HRESULT hr = screen->dev->CreateCommittedResource(
+      &heap, flags, &desc, D3D12_RESOURCE_STATE_COMMON, nullptr,
+      IID_PPV_ARGS(&share->diagnostic_destination));
+   if (FAILED(hr)) {
+      fprintf(stderr, "ASB_D3D12 copy_probe mode=%s stage=create-destination "
+                   "status=fail hr=0x%08x shared=%u\n",
+                   copy_probe_mode_name(share->probe_mode),
+                   static_cast<unsigned>(hr), shared ? 1U : 0U);
+      return false;
+   }
+   if (shared) {
+      HANDLE raw = nullptr;
+      hr = screen->dev->CreateSharedHandle(
+         share->diagnostic_destination.Get(), nullptr, GENERIC_ALL, nullptr,
+         &raw);
+      const int fd = static_cast<int>(reinterpret_cast<intptr_t>(raw));
+      if (FAILED(hr) || fd < 0) {
+         fprintf(stderr, "ASB_D3D12 copy_probe mode=%s stage=export-destination "
+                      "status=fail hr=0x%08x fd=%d\n",
+                      copy_probe_mode_name(share->probe_mode),
+                      static_cast<unsigned>(hr), fd);
+         if (raw && fd >= 0)
+            close(fd);
+         share->diagnostic_destination.Reset();
+         return false;
+      }
+      share->diagnostic_resource_fd = fd;
+   }
+   return true;
+}
+
+static bool record_diagnostic_copy(struct d3d12_context *ctx,
+                                   struct d3d12_resource *source,
+                                   AppsandboxShare *share,
+                                   bool shared)
+{
+   if (!ensure_diagnostic_destination(ctx, source, share, shared))
+      return false;
+   d3d12_transition_resource_state(ctx, source,
+                                   D3D12_RESOURCE_STATE_COPY_SOURCE,
+                                   D3D12_TRANSITION_FLAG_INVALIDATE_BINDINGS);
+   d3d12_apply_resource_states(ctx, false);
+   D3D12_RESOURCE_BARRIER barrier = {};
+   barrier.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+   barrier.Transition.pResource = share->diagnostic_destination.Get();
+   barrier.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+   barrier.Transition.StateBefore = D3D12_RESOURCE_STATE_COMMON;
+   barrier.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_DEST;
+   ctx->cmdlist->ResourceBarrier(1, &barrier);
+   ctx->cmdlist->CopyResource(share->diagnostic_destination.Get(),
+                              d3d12_resource_resource(source));
+   barrier.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+   barrier.Transition.StateAfter = D3D12_RESOURCE_STATE_COMMON;
+   ctx->cmdlist->ResourceBarrier(1, &barrier);
+   d3d12_transition_resource_state(ctx, source,
+                                   D3D12_RESOURCE_STATE_RENDER_TARGET,
+                                   D3D12_TRANSITION_FLAG_INVALIDATE_BINDINGS);
+   d3d12_apply_resource_states(ctx, false);
+   ctx->has_commands = true;
+   return true;
+}
+
+static bool record_diagnostic_barrier(struct d3d12_context *ctx,
+                                      struct d3d12_resource *source)
+{
+   d3d12_transition_resource_state(ctx, source,
+                                   D3D12_RESOURCE_STATE_COPY_SOURCE,
+                                   D3D12_TRANSITION_FLAG_INVALIDATE_BINDINGS);
+   d3d12_apply_resource_states(ctx, false);
+   d3d12_transition_resource_state(ctx, source,
+                                   D3D12_RESOURCE_STATE_RENDER_TARGET,
+                                   D3D12_TRANSITION_FLAG_INVALIDATE_BINDINGS);
+   d3d12_apply_resource_states(ctx, false);
+   ctx->has_commands = true;
+   return true;
+}
+
+static void run_diagnostic_fence(struct d3d12_context *ctx,
+                                 AppsandboxShare *share)
+{
+   struct d3d12_screen *screen = d3d12_screen(ctx->base.screen);
+   if (!share->diagnostic_fence) {
+      const HRESULT create_hr = screen->dev->CreateFence(
+         0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(&share->diagnostic_fence));
+      if (FAILED(create_hr)) {
+         const HRESULT removed_reason = screen->dev->GetDeviceRemovedReason();
+         fprintf(stderr, "ASB_D3D12 copy_probe mode=%s status=fail "
+                      "stage=create-diagnostic-fence hr=0x%08x "
+                      "removed_reason=0x%08x\n",
+                      copy_probe_mode_name(share->probe_mode),
+                      static_cast<unsigned>(create_hr),
+                      static_cast<unsigned>(removed_reason));
+         share->diagnostic_done = true;
+         return;
+      }
+   }
+   share->diagnostic_event_fd = eventfd(0, EFD_CLOEXEC | EFD_NONBLOCK);
+   const uint64_t value = ++share->diagnostic_value;
+   HRESULT signal_hr = screen->cmdqueue->Signal(share->diagnostic_fence.Get(), value);
+   bool completion_ok = false;
+   if (SUCCEEDED(signal_hr) && share->diagnostic_event_fd >= 0 &&
+       set_completion(share->diagnostic_fence.Get(), value,
+                      share->diagnostic_event_fd)) {
+      struct pollfd pfd = {share->diagnostic_event_fd, POLLIN, 0};
+      int result;
+      do
+         result = poll(&pfd, 1, kDiagnosticTimeoutMs);
+      while (result < 0 && errno == EINTR);
+      eventfd_t event_value = 0;
+      completion_ok = result > 0 && (pfd.revents & POLLIN) &&
+                      eventfd_read(share->diagnostic_event_fd, &event_value) == 0 &&
+                      event_value != 0;
+   }
+   const HRESULT removed_reason = screen->dev->GetDeviceRemovedReason();
+   const bool ok = SUCCEEDED(signal_hr) && completion_ok &&
+                   removed_reason == S_OK;
+   fprintf(stderr, "ASB_D3D12 copy_probe mode=%s status=%s signal_hr=0x%08x "
+                "completion=%s removed_reason=0x%08x\n",
+                copy_probe_mode_name(share->probe_mode), ok ? "pass" : "fail",
+                static_cast<unsigned>(signal_hr), completion_ok ? "pass" : "fail",
+                static_cast<unsigned>(removed_reason));
+   close_fd(share->diagnostic_event_fd);
+   share->diagnostic_done = true;
+}
+
+static bool connect_share(AppsandboxShare *share)
+{
+   const char *path = "/run/appsandbox/display-d3d12.sock";
+   if (strlen(path) >= sizeof(((struct sockaddr_un *)nullptr)->sun_path))
+      return false;
+   share->socket_fd = socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0);
+   if (share->socket_fd < 0)
+      return false;
+   sockaddr_un address = {};
+   address.sun_family = AF_UNIX;
+   strncpy(address.sun_path, path, sizeof(address.sun_path) - 1);
+   if (connect(share->socket_fd, reinterpret_cast<sockaddr *>(&address),
+               sizeof(address)) != 0)
+      return false;
+   return true;
+}
+
+static bool ensure_ring(struct d3d12_context *ctx,
+                        struct d3d12_resource *source,
+                        AppsandboxShare *share)
+{
+   if (share->initialized)
+      return true;
+   struct d3d12_screen *screen = d3d12_screen(ctx->base.screen);
+   ID3D12Resource *source_resource = d3d12_resource_resource(source);
+   const D3D12_RESOURCE_DESC source_desc = source_resource->GetDesc();
+   if (!ensure_logged) {
+      fprintf(stderr, "ASB_D3D12 ensure-ring source width=%llu height=%u format=%u flags=0x%08x\\n",
+              static_cast<unsigned long long>(source_desc.Width), source_desc.Height,
+              static_cast<unsigned>(source_desc.Format), static_cast<unsigned>(source_desc.Flags));
+      fflush(stderr);
+      ensure_logged = true;
+   }
+   if (source_desc.Width == 0 || source_desc.Height == 0 ||
+       source_desc.Width > 16384 || source_desc.Height > 16384 ||
+       (source_desc.Width & 1) || (source_desc.Height & 1) ||
+       source_desc.SampleDesc.Count != 1 ||
+       !(source_desc.Format == DXGI_FORMAT_R8G8B8A8_UNORM ||
+         source_desc.Format == DXGI_FORMAT_B8G8R8A8_UNORM)) {
+      fprintf(stderr, "ASB_D3D12 blocker=real-render-target width=%llu height=%u format=%u\n",
+              static_cast<unsigned long long>(source_desc.Width), source_desc.Height,
+              static_cast<unsigned>(source_desc.Format));
+      fflush(stderr);
+      return false;
+   }
+   debug_printf("ASB_D3D12 target_resource=%p width=%llu height=%u "
+                "format=%s dxgi_format=%u source_state=RENDER_TARGET "
+                "source_desc_flags=0x%08x ring_heap_flag=D3D12_HEAP_FLAG_SHARED "
+                "ring_slots=%u modifier=not-applicable\n",
+                source_resource, static_cast<unsigned long long>(source_desc.Width),
+                source_desc.Height,
+                source_desc.Format == DXGI_FORMAT_R8G8B8A8_UNORM ? "RGBA8" : "BGRA8",
+                static_cast<unsigned>(source_desc.Format), static_cast<unsigned>(source_desc.Flags),
+                kSlotCount);
+   if (!connect_share(share)) {
+      fprintf(stderr, "ASB_D3D12 blocker=consumer-connect errno=%d\n", errno);
+      fflush(stderr);
+      return false;
+   }
+
+   D3D12_HEAP_PROPERTIES heap = {};
+   heap.Type = D3D12_HEAP_TYPE_DEFAULT;
+   heap.CreationNodeMask = 1;
+   heap.VisibleNodeMask = 1;
+   for (uint32_t i = 0; i < kSlotCount; ++i) {
+      if (FAILED(screen->dev->CreateCommittedResource(
+             &heap, D3D12_HEAP_FLAG_SHARED, &source_desc,
+             D3D12_RESOURCE_STATE_COMMON, nullptr,
+             IID_PPV_ARGS(&share->slots[i].resource))))
+         return false;
+      HANDLE raw = nullptr;
+      if (FAILED(screen->dev->CreateSharedHandle(
+             share->slots[i].resource.Get(), nullptr, GENERIC_ALL, nullptr,
+             &raw)))
+         return false;
+      share->slots[i].resource_fd = static_cast<int>(reinterpret_cast<intptr_t>(raw));
+      share->slots[i].ready_fd = eventfd(0, EFD_CLOEXEC | EFD_NONBLOCK);
+      if (share->slots[i].resource_fd < 0 || share->slots[i].ready_fd < 0)
+         return false;
+   }
+   if (FAILED(screen->dev->CreateFence(0, D3D12_FENCE_FLAG_NONE,
+                                       IID_PPV_ARGS(&share->fence))))
+      return false;
+
+   ResourceBundle bundle = {kMagic, kResourceBundle,
+                            static_cast<uint32_t>(source_desc.Width), source_desc.Height,
+                            kSlotCount, 0,
+                            static_cast<uint32_t>(source_desc.Format), 0, 1,
+                            kSlotCount};
+   std::vector<int> fds;
+   for (Slot &slot : share->slots) {
+      fds.push_back(slot.resource_fd);
+      fds.push_back(slot.ready_fd);
+   }
+   if (!send_fds(share->socket_fd, &bundle, sizeof(bundle), fds))
+      return false;
+   for (Slot &slot : share->slots)
+      close_fd(slot.resource_fd); /* Mesa keeps the ID3D12Resource alive. */
+   ConsumerReady ready = {};
+   std::vector<int> received;
+   if (!recv_fds(share->socket_fd, &ready, sizeof(ready), received) ||
+       ready.magic != kMagic || ready.type != kConsumerReady ||
+       ready.opened_resources != kSlotCount ||
+       ready.done_eventfds != kSlotCount || received.size() != kSlotCount)
+      return false;
+   for (uint32_t i = 0; i < kSlotCount; ++i)
+      share->slots[i].done_fd = received[i];
+   share->initialized = true;
+   fprintf(stderr, "APPSANDBOX stage=d3d12-renderer renderer=D3D12\n");
+   fflush(stderr);
+   debug_printf("APPSANDBOX stage=real-render-target synthetic_source=0 "
+                "width=%u height=%u format=%s dxgi_format=%u\n",
+                static_cast<unsigned>(source_desc.Width), source_desc.Height,
+                source_desc.Format == DXGI_FORMAT_R8G8B8A8_UNORM ? "RGBA8" : "BGRA8",
+                static_cast<unsigned>(source_desc.Format));
+   debug_printf("APPSANDBOX stage=shared-resource format=%s "
+                "native_d3d12_shared=1 gpu_copy=1 cpu_copy=0 resource_count=3\n",
+                source_desc.Format == DXGI_FORMAT_R8G8B8A8_UNORM ? "RGBA8" : "BGRA8");
+   return true;
+}
+
+static bool record_copy(struct d3d12_context *ctx,
+                        struct d3d12_resource *source,
+                        AppsandboxShare *share)
+{
+   if (!ctx->has_commands || !ensure_ring(ctx, source, share))
+      return false;
+   ID3D12Resource *source_resource = d3d12_resource_resource(source);
+   if (share->last_source != nullptr && share->last_source != source_resource)
+      ++share->source_resource_changes;
+   share->last_source = source_resource;
+   const uint32_t slot_index = static_cast<uint32_t>(share->frame % kSlotCount);
+   uint64_t recycle_us = 0;
+   if (share->frame >= kSlotCount &&
+       !try_done(share->slots[slot_index].done_fd, &recycle_us)) {
+      debug_printf("ASB_D3D12 capture_drop=ring-full slot=%u\n", slot_index);
+      return false;
+   }
+   if (share->frame >= kSlotCount)
+      share->slot_recycle_us.push_back(recycle_us);
+
+   share->copy_start_ns = now_ns();
+   d3d12_transition_resource_state(ctx, source, D3D12_RESOURCE_STATE_COPY_SOURCE,
+                                   D3D12_TRANSITION_FLAG_INVALIDATE_BINDINGS);
+   d3d12_apply_resource_states(ctx, false);
+   D3D12_RESOURCE_BARRIER barrier = {};
+   barrier.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+   barrier.Transition.pResource = share->slots[slot_index].resource.Get();
+   barrier.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+   barrier.Transition.StateBefore = D3D12_RESOURCE_STATE_COMMON;
+   barrier.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_DEST;
+   ctx->cmdlist->ResourceBarrier(1, &barrier);
+   ctx->cmdlist->CopyResource(share->slots[slot_index].resource.Get(),
+                              d3d12_resource_resource(source));
+   barrier.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+   barrier.Transition.StateAfter = D3D12_RESOURCE_STATE_COMMON;
+   ctx->cmdlist->ResourceBarrier(1, &barrier);
+   d3d12_transition_resource_state(ctx, source,
+                                   D3D12_RESOURCE_STATE_RENDER_TARGET,
+                                   D3D12_TRANSITION_FLAG_INVALIDATE_BINDINGS);
+   d3d12_apply_resource_states(ctx, false);
+   ctx->has_commands = true;
+   share->pending_slot = slot_index;
+   share->pending = true;
+   return true;
+}
+
+static bool ensure_postflush_destination(struct d3d12_context *ctx,
+                                          AppsandboxShare *share,
+                                          bool shared)
+{
+   if (share->postflush_destination)
+      return share->postflush_destination->GetDesc().Width ==
+             share->pending_capture.source_desc.Width;
+
+   struct d3d12_screen *screen = d3d12_screen(ctx->base.screen);
+   D3D12_HEAP_PROPERTIES heap = {};
+   heap.Type = D3D12_HEAP_TYPE_DEFAULT;
+   heap.CreationNodeMask = 1;
+   heap.VisibleNodeMask = 1;
+   const D3D12_HEAP_FLAGS flags =
+      shared ? D3D12_HEAP_FLAG_SHARED : D3D12_HEAP_FLAG_NONE;
+   const HRESULT hr = screen->dev->CreateCommittedResource(
+      &heap, flags, &share->pending_capture.source_desc,
+      D3D12_RESOURCE_STATE_COMMON, nullptr,
+      IID_PPV_ARGS(&share->postflush_destination));
+   if (FAILED(hr)) {
+      fprintf(stderr, "ASB_D3D12 postflush_probe mode=%s "
+                   "stage=create-destination status=fail hr=0x%08x\n",
+              copy_probe_mode_name(share->probe_mode), static_cast<unsigned>(hr));
+      return false;
+   }
+   if (shared) {
+      HANDLE raw = nullptr;
+      const HRESULT export_hr = screen->dev->CreateSharedHandle(
+         share->postflush_destination.Get(), nullptr, GENERIC_ALL, nullptr, &raw);
+      share->postflush_resource_fd =
+         static_cast<int>(reinterpret_cast<intptr_t>(raw));
+      if (FAILED(export_hr) || share->postflush_resource_fd < 0) {
+         fprintf(stderr, "ASB_D3D12 postflush_probe mode=%s "
+                      "stage=export-destination status=fail hr=0x%08x fd=%d\n",
+                 copy_probe_mode_name(share->probe_mode),
+                 static_cast<unsigned>(export_hr), share->postflush_resource_fd);
+         if (raw && share->postflush_resource_fd >= 0)
+            close(share->postflush_resource_fd);
+         share->postflush_resource_fd = -1;
+         share->postflush_destination.Reset();
+         return false;
+      }
+   }
+   return true;
+}
+
+static bool ensure_postflush_capture_objects(struct d3d12_context *ctx,
+                                              AppsandboxShare *share)
+{
+   struct d3d12_screen *screen = d3d12_screen(ctx->base.screen);
+   Slot &slot = share->slots[share->pending_capture.slot];
+   if (slot.submitted) {
+      if (!share->capture_fence ||
+          share->capture_fence->GetCompletedValue() < slot.capture_fence_value ||
+          (postflush_needs_consumer(share->probe_mode) &&
+           !try_done(slot.done_fd, nullptr))) {
+         fprintf(stderr, "ASB_D3D12 postflush_probe mode=%s "
+                      "stage=slot-reuse status=fail slot=%u\n",
+                 copy_probe_mode_name(share->probe_mode),
+                 share->pending_capture.slot);
+         return false;
+      }
+      slot.submitted = false;
+      slot.source_keepalive.Reset();
+   }
+   if (!slot.allocator) {
+      const HRESULT hr = screen->dev->CreateCommandAllocator(
+         D3D12_COMMAND_LIST_TYPE_DIRECT, IID_PPV_ARGS(&slot.allocator));
+      if (FAILED(hr)) {
+         fprintf(stderr, "ASB_D3D12 postflush_probe mode=%s "
+                      "stage=create-capture-allocator status=fail hr=0x%08x\n",
+                 copy_probe_mode_name(share->probe_mode), static_cast<unsigned>(hr));
+         return false;
+      }
+   }
+   if (!slot.command_list) {
+      const HRESULT hr = screen->dev->CreateCommandList(
+         0, D3D12_COMMAND_LIST_TYPE_DIRECT, slot.allocator.Get(), nullptr,
+         IID_PPV_ARGS(&slot.command_list));
+      if (FAILED(hr) || FAILED(slot.command_list->Close())) {
+         fprintf(stderr, "ASB_D3D12 postflush_probe mode=%s "
+                      "stage=create-capture-list status=fail hr=0x%08x\n",
+                 copy_probe_mode_name(share->probe_mode), static_cast<unsigned>(hr));
+         slot.command_list.Reset();
+         return false;
+      }
+   }
+   const HRESULT allocator_hr = slot.allocator->Reset();
+   fprintf(stderr, "ASB_D3D12 postflush_probe mode=%s "
+                "capture_allocator_reset=%s\n",
+           copy_probe_mode_name(share->probe_mode),
+           SUCCEEDED(allocator_hr) ? "pass" : "fail");
+   if (FAILED(allocator_hr))
+      return false;
+   const HRESULT list_hr = slot.command_list->Reset(slot.allocator.Get(), nullptr);
+   fprintf(stderr, "ASB_D3D12 postflush_probe mode=%s "
+                "capture_list_reset=%s\n",
+           copy_probe_mode_name(share->probe_mode),
+           SUCCEEDED(list_hr) ? "pass" : "fail");
+   return SUCCEEDED(list_hr);
+}
+
+static bool record_postflush_capture(AppsandboxShare *share,
+                                      ID3D12Resource *destination)
+{
+   Slot &slot = share->slots[share->pending_capture.slot];
+   ID3D12GraphicsCommandList *list = slot.command_list.Get();
+   ID3D12Resource *source = share->pending_capture.source.Get();
+   D3D12_RESOURCE_BARRIER barriers[2] = {};
+   barriers[0].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+   barriers[0].Transition.pResource = source;
+   barriers[0].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+   barriers[0].Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+   barriers[0].Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+   barriers[1].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+   barriers[1].Transition.pResource = destination;
+   barriers[1].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+   barriers[1].Transition.StateBefore = D3D12_RESOURCE_STATE_COMMON;
+   barriers[1].Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_DEST;
+   list->ResourceBarrier(2, barriers);
+   list->CopyResource(destination, source);
+   barriers[0].Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_SOURCE;
+   barriers[0].Transition.StateAfter = D3D12_RESOURCE_STATE_RENDER_TARGET;
+   barriers[1].Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+   barriers[1].Transition.StateAfter = D3D12_RESOURCE_STATE_COMMON;
+   list->ResourceBarrier(2, barriers);
+   const HRESULT close_hr = list->Close();
+   fprintf(stderr, "ASB_D3D12 postflush_probe mode=%s "
+                "capture_list_close=%s\n",
+           copy_probe_mode_name(share->probe_mode),
+           SUCCEEDED(close_hr) ? "pass" : "fail");
+   return SUCCEEDED(close_hr);
+}
+
+static bool record_copy_probe(struct d3d12_context *ctx,
+                              struct d3d12_resource *source,
+                              AppsandboxShare *share)
+{
+   if (share->diagnostic_done)
+      return false;
+   switch (share->probe_mode) {
+   case CopyProbeMode::RingOnly:
+      if (!ensure_ring(ctx, source, share))
+         return false;
+      /* Submit an otherwise empty list so the fence samples this queue. */
+      ctx->has_commands = true;
+      share->diagnostic_pending = true;
+      return true;
+   case CopyProbeMode::BarrierOnly:
+      if (!record_diagnostic_barrier(ctx, source))
+         return false;
+      share->diagnostic_pending = true;
+      return true;
+   case CopyProbeMode::LocalCopy:
+      if (!record_diagnostic_copy(ctx, source, share, false))
+         return false;
+      share->diagnostic_pending = true;
+      return true;
+   case CopyProbeMode::SharedCopyNoConsumer:
+      if (!record_diagnostic_copy(ctx, source, share, true))
+         return false;
+      share->diagnostic_pending = true;
+      return true;
+   case CopyProbeMode::SharedCopyConsumer:
+      if (!record_copy(ctx, source, share))
+         return false;
+      share->diagnostic_pending = true;
+      return true;
+   case CopyProbeMode::Invalid:
+   case CopyProbeMode::PostflushLocalCopy:
+   case CopyProbeMode::PostflushSharedCopyNoConsumer:
+   case CopyProbeMode::PostflushSharedCopyConsumer:
+   case CopyProbeMode::None:
+      break;
+   }
+   return false;
+}
+
+static bool prepare_postflush_capture(struct d3d12_context *ctx,
+                                       CopyProbeMode requested_mode,
+                                       AppsandboxShare *share)
+{
+   if (!is_postflush_probe(requested_mode))
+      return false;
+   if (share->postflush_submitted)
+      return false;
+   share->probe_mode = requested_mode;
+   if (!ctx->fb.cbufs[0].texture) {
+      fprintf(stderr, "ASB_D3D12 postflush_probe mode=%s prepare=fail "
+                   "reason=no-framebuffer\n",
+              copy_probe_mode_name(requested_mode));
+      return true;
+   }
+   struct d3d12_resource *source = d3d12_resource(ctx->fb.cbufs[0].texture);
+   log_postflush_source(source, requested_mode,
+                        requested_mode != CopyProbeMode::PostflushLocalCopy);
+   if (!postflush_source_supported(source)) {
+      fprintf(stderr, "ASB_D3D12 postflush_probe mode=%s prepare=fail "
+                   "reason=unsupported-source\n",
+              copy_probe_mode_name(requested_mode));
+      return true;
+   }
+   share->pending_capture.source = d3d12_resource_resource(source);
+   share->pending_capture.source_desc =
+      d3d12_resource_resource(source)->GetDesc();
+   share->pending_capture.slot =
+      postflush_needs_consumer(requested_mode) ?
+      static_cast<uint32_t>(share->frame % kSlotCount) : 0;
+   share->postflush_slot = share->pending_capture.slot;
+   share->slots[share->pending_capture.slot].source_keepalive =
+      share->pending_capture.source;
+   /* Prepare only retains immutable source metadata and never creates GPU work. */
+   share->pending_capture.valid = true;
+   fprintf(stderr, "ASB_D3D12 postflush_probe mode=%s prepare=pass\n",
+           copy_probe_mode_name(requested_mode));
+   return true;
+}
+
+static void submit_postflush_capture(struct d3d12_context *ctx,
+                                      AppsandboxShare *share,
+                                      bool mesa_flush_succeeded)
+{
+   const CopyProbeMode mode = share->probe_mode;
+   const bool shared = mode != CopyProbeMode::PostflushLocalCopy;
+   fprintf(stderr, "ASB_D3D12 postflush_probe mode=%s mesa_flush=%s\n",
+           copy_probe_mode_name(mode), mesa_flush_succeeded ? "pass" : "fail");
+   share->postflush_submitted = true;
+   if (!mesa_flush_succeeded || !share->pending_capture.valid) {
+      if (share->pending_capture.valid)
+         share->slots[share->pending_capture.slot].source_keepalive.Reset();
+      fprintf(stderr, "ASB_D3D12 postflush_probe mode=%s "
+                   "capture_submit=fail capture_completion=timeout "
+                   "removed_reason=0x%08x\n",
+              copy_probe_mode_name(mode),
+              static_cast<unsigned>(d3d12_screen(ctx->base.screen)->dev->GetDeviceRemovedReason()));
+      share->pending_capture.valid = false;
+      return;
+   }
+   if (mode == CopyProbeMode::PostflushSharedCopyConsumer) {
+      if (!share->initialized) {
+         struct d3d12_resource *current_source =
+            ctx->fb.cbufs[0].texture ?
+            d3d12_resource(ctx->fb.cbufs[0].texture) : nullptr;
+         if (!current_source ||
+             d3d12_resource_resource(current_source) !=
+             share->pending_capture.source.Get() ||
+             !ensure_ring(ctx, current_source, share)) {
+            fprintf(stderr, "ASB_D3D12 postflush_probe mode=%s "
+                         "capture_submit=fail reason=consumer-setup\n",
+                    copy_probe_mode_name(mode));
+            log_postflush_failure(ctx, share, "consumer-setup");
+            share->pending_capture.valid = false;
+            return;
+         }
+      }
+   } else if (!ensure_postflush_destination(ctx, share, shared)) {
+      log_postflush_failure(ctx, share, "create-destination");
+      share->pending_capture.valid = false;
+      return;
+   }
+   if (!share->capture_fence) {
+      struct d3d12_screen *screen = d3d12_screen(ctx->base.screen);
+      const HRESULT hr = screen->dev->CreateFence(
+         0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(&share->capture_fence));
+      if (FAILED(hr)) {
+         fprintf(stderr, "ASB_D3D12 postflush_probe mode=%s "
+                      "capture_submit=fail stage=create-capture-fence "
+                      "hr=0x%08x\n",
+                 copy_probe_mode_name(mode), static_cast<unsigned>(hr));
+         log_postflush_failure(ctx, share, "create-capture-fence");
+         share->pending_capture.valid = false;
+         return;
+      }
+   }
+   if (!ensure_postflush_capture_objects(ctx, share)) {
+      log_postflush_failure(ctx, share, "capture-list-reset");
+      share->pending_capture.valid = false;
+      return;
+   }
+   Slot &slot = share->slots[share->pending_capture.slot];
+   ID3D12Resource *destination =
+      mode == CopyProbeMode::PostflushSharedCopyConsumer ?
+      slot.resource.Get() : share->postflush_destination.Get();
+   if (!record_postflush_capture(share, destination)) {
+      log_postflush_failure(ctx, share, "capture-list-close");
+      share->pending_capture.valid = false;
+      return;
+   }
+   struct d3d12_screen *screen = d3d12_screen(ctx->base.screen);
+   ID3D12CommandList *lists[] = {slot.command_list.Get()};
+   screen->cmdqueue->ExecuteCommandLists(1, lists);
+   slot.submitted = true;
+   share->postflush_submitted = true;
+   const HRESULT submit_reason = screen->dev->GetDeviceRemovedReason();
+   if (FAILED(submit_reason)) {
+      log_postflush_failure(ctx, share, "execute-command-lists");
+      share->pending_capture.valid = false;
+      return;
+   }
+   fprintf(stderr, "ASB_D3D12 postflush_probe mode=%s capture_submit=pass\n",
+           copy_probe_mode_name(mode));
+   const uint64_t fence_value = ++share->next_capture_fence_value;
+   slot.capture_fence_value = fence_value;
+   const HRESULT signal_hr =
+      screen->cmdqueue->Signal(share->capture_fence.Get(), fence_value);
+   fprintf(stderr, "ASB_D3D12 postflush_probe mode=%s "
+                "queue_signal_hr=0x%08x\n",
+           copy_probe_mode_name(mode), static_cast<unsigned>(signal_hr));
+   share->postflush_event_fd = eventfd(0, EFD_CLOEXEC | EFD_NONBLOCK);
+   const bool event_registered =
+      SUCCEEDED(signal_hr) && share->postflush_event_fd >= 0 &&
+      set_completion(share->capture_fence.Get(), fence_value,
+                     share->postflush_event_fd);
+   bool ready_registered = true;
+   if (mode == CopyProbeMode::PostflushSharedCopyConsumer)
+      ready_registered = set_completion(share->capture_fence.Get(), fence_value,
+                                        slot.ready_fd);
+   const bool completion = event_registered &&
+      wait_capture_event(share->postflush_event_fd, kDiagnosticTimeoutMs);
+   const HRESULT removed_reason = screen->dev->GetDeviceRemovedReason();
+   fprintf(stderr, "ASB_D3D12 postflush_probe mode=%s "
+                "capture_completion=%s removed_reason=0x%08x "
+                "consumer_ready=%s\n",
+           copy_probe_mode_name(mode), completion ? "pass" : "timeout",
+           static_cast<unsigned>(removed_reason),
+           ready_registered ? "pass" : "fail");
+   if (completion && ready_registered &&
+       mode == CopyProbeMode::PostflushSharedCopyConsumer) {
+      FrameInfo info = {kMagic, kFrameInfo, share->frame,
+                        share->pending_capture.slot, 0, now_ns(),
+                        31U, 127U, 223U, 255U, 1};
+      if (send_fds(share->socket_fd, &info, sizeof(info), {}))
+         ++share->frame;
+      else
+         fprintf(stderr, "ASB_D3D12 postflush_probe mode=%s "
+                      "consumer_ready=fail reason=control-socket\n",
+                 copy_probe_mode_name(mode));
+   }
+   if (completion && mode != CopyProbeMode::PostflushSharedCopyConsumer)
+      slot.source_keepalive.Reset();
+   share->pending_capture.source.Reset();
+   share->pending_capture.valid = false;
+   close_fd(share->postflush_event_fd);
+}
+
+} // namespace
+
+bool d3d12_appsandbox_share_prepare_postflush(struct d3d12_context *ctx)
+{
+   const char *display = getenv("ASB_D3D12_DISPLAY");
+   const CopyProbeMode requested_mode = copy_probe_mode();
+   if (!display || strcmp(display, "1") != 0)
+      return false;
+   if (requested_mode == CopyProbeMode::Invalid) {
+      if (!invalid_probe_logged) {
+         const char *value = getenv("ASB_D3D12_COPY_PROBE");
+         fprintf(stderr, "ASB_D3D12 blocker=invalid-copy-probe-mode value=%s\n",
+                 value ? value : "");
+         fflush(stderr);
+         invalid_probe_logged = true;
+      }
+      return false;
+   }
+   if (!is_postflush_probe(requested_mode))
+      return false;
+   auto **state = reinterpret_cast<AppsandboxShare **>(&ctx->appsandbox_share);
+   if (!*state)
+      *state = new AppsandboxShare();
+   return prepare_postflush_capture(ctx, requested_mode, *state);
+}
+
+void d3d12_appsandbox_share_submit_postflush(
+   struct d3d12_context *ctx, bool mesa_flush_succeeded)
+{
+   auto *share = reinterpret_cast<AppsandboxShare *>(ctx->appsandbox_share);
+   if (!share || !is_postflush_probe(share->probe_mode))
+      return;
+   submit_postflush_capture(ctx, share, mesa_flush_succeeded);
+}
+
+bool d3d12_appsandbox_share_record(struct d3d12_context *ctx)
+{
+   const char *display = getenv("ASB_D3D12_DISPLAY");
+   const CopyProbeMode requested_mode = copy_probe_mode();
+   if (!display || strcmp(display, "1") != 0)
+      return false;
+   if (requested_mode == CopyProbeMode::Invalid) {
+      if (!invalid_probe_logged) {
+         const char *value = getenv("ASB_D3D12_COPY_PROBE");
+         fprintf(stderr, "ASB_D3D12 blocker=invalid-copy-probe-mode value=%s\n",
+                 value ? value : "");
+         fflush(stderr);
+         invalid_probe_logged = true;
+      }
+      return false;
+   }
+   if (is_postflush_probe(requested_mode))
+      return false;
+   const bool needs_consumer =
+      requested_mode == CopyProbeMode::None ||
+      requested_mode == CopyProbeMode::RingOnly ||
+      requested_mode == CopyProbeMode::SharedCopyConsumer;
+   if (!display || strcmp(display, "1") != 0 ||
+       (needs_consumer && access("/run/appsandbox/display-d3d12.sock", F_OK) != 0))
+      return false;
+   void *cbuf_texture = (void *)ctx->fb.cbufs[0].texture;
+   if (cbuf_texture && !hook_logged) {
+      fprintf(stderr, "ASB_D3D12 hook-target has_commands=%d cbuf_texture=%p\\n",
+              ctx->has_commands, cbuf_texture);
+      fflush(stderr);
+      hook_logged = true;
+   } else if (!cbuf_texture && !empty_hook_logged) {
+      fprintf(stderr, "ASB_D3D12 hook-empty has_commands=%d\\n",
+              ctx->has_commands);
+      fflush(stderr);
+      empty_hook_logged = true;
+   }
+   if (!ctx->fb.cbufs[0].texture)
+      return false;
+   auto **state = reinterpret_cast<AppsandboxShare **>(&ctx->appsandbox_share);
+   if (!*state) {
+      *state = new AppsandboxShare();
+      (*state)->probe_mode = requested_mode;
+      if (requested_mode != CopyProbeMode::None)
+         fprintf(stderr, "ASB_D3D12 copy_probe mode=%s stage=begin one_frame=1\n",
+                      copy_probe_mode_name(requested_mode));
+   }
+   struct d3d12_resource *source = d3d12_resource(ctx->fb.cbufs[0].texture);
+   if ((*state)->probe_mode != CopyProbeMode::None)
+      return record_copy_probe(ctx, source, *state);
+   return record_copy(ctx, source, *state);
+}
+
+void d3d12_appsandbox_share_publish(struct d3d12_context *ctx)
+{
+   auto *share = reinterpret_cast<AppsandboxShare *>(ctx->appsandbox_share);
+   if (!share)
+      return;
+   struct d3d12_screen *screen = d3d12_screen(ctx->base.screen);
+   if (share->pending) {
+      if (share->copy_start_ns != 0)
+         share->gpu_copy_us.push_back((now_ns() - share->copy_start_ns) / 1000);
+      const uint64_t value = share->frame + 1;
+      const bool ready_ok =
+         SUCCEEDED(screen->cmdqueue->Signal(share->fence.Get(), value)) &&
+         set_completion(share->fence.Get(), value,
+                        share->slots[share->pending_slot].ready_fd);
+      if (!ready_ok) {
+         debug_printf("ASB_D3D12 blocker=producer-eventfd-sync\n");
+      } else {
+         const uint8_t expected_r = 31U;
+         const uint8_t expected_g = 127U;
+         const uint8_t expected_b = 223U;
+         FrameInfo info = {kMagic, kFrameInfo, share->frame, share->pending_slot,
+                           ((share->frame + 1) % 120) == 0 ? 1U : 0U,
+                           now_ns(),
+                           expected_r, expected_g, expected_b, 255,
+                           1};
+         if (!send_fds(share->socket_fd, &info, sizeof(info), {}))
+            debug_printf("ASB_D3D12 blocker=consumer-control-socket\n");
+         ++share->frame;
+      }
+      share->pending = false;
+   }
+   if (share->diagnostic_pending) {
+      run_diagnostic_fence(ctx, share);
+      share->diagnostic_pending = false;
+   }
+}
+
+void d3d12_appsandbox_share_destroy(struct d3d12_context *ctx)
+{
+   auto *share = reinterpret_cast<AppsandboxShare *>(ctx->appsandbox_share);
+   if (!share)
+      return;
+   debug_printf("gpu_copy_us p50=%.3f p95=%.3f p99=%.3f samples=%zu\n",
+                percentile_us(share->gpu_copy_us, 0.50),
+                percentile_us(share->gpu_copy_us, 0.95),
+                percentile_us(share->gpu_copy_us, 0.99),
+                share->gpu_copy_us.size());
+   debug_printf("slot_recycle_us p50=%.3f p95=%.3f p99=%.3f samples=%zu\n",
+                percentile_us(share->slot_recycle_us, 0.50),
+                percentile_us(share->slot_recycle_us, 0.95),
+                percentile_us(share->slot_recycle_us, 0.99),
+                share->slot_recycle_us.size());
+   debug_printf("ASB_D3D12 source_resource_changes=%llu frames=%llu\n",
+                static_cast<unsigned long long>(share->source_resource_changes),
+                static_cast<unsigned long long>(share->frame));
+   if (is_postflush_probe(share->probe_mode) &&
+       postflush_needs_consumer(share->probe_mode) &&
+       share->postflush_submitted &&
+       share->slots[share->postflush_slot].submitted) {
+      const bool consumer_done = wait_capture_event(
+         share->slots[share->postflush_slot].done_fd, kDiagnosticTimeoutMs);
+      fprintf(stderr, "ASB_D3D12 postflush_probe mode=%s "
+                   "consumer_done=%s\n",
+              copy_probe_mode_name(share->probe_mode),
+              consumer_done ? "pass" : "timeout");
+   }
+   close_fd(share->diagnostic_resource_fd);
+   close_fd(share->diagnostic_event_fd);
+   close_fd(share->postflush_resource_fd);
+   close_fd(share->postflush_event_fd);
+   for (Slot &slot : share->slots) {
+      close_fd(slot.resource_fd);
+      close_fd(slot.ready_fd);
+      close_fd(slot.done_fd);
+   }
+   close_fd(share->socket_fd);
+   delete share;
+   ctx->appsandbox_share = nullptr;
+}
