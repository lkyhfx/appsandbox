+/* SPDX-License-Identifier: MIT */
+#ifndef D3D12_APPSANDBOX_SHARE_H
+#define D3D12_APPSANDBOX_SHARE_H
+
+struct d3d12_context;
+
+/* Returns true when a copy was recorded in the current command list. */
+bool d3d12_appsandbox_share_record(struct d3d12_context *ctx);
+
+/* Prepare an opt-in post-flush probe without recording Mesa GPU work. */
+bool d3d12_appsandbox_share_prepare_postflush(struct d3d12_context *ctx);
+
+/* Submit the prepared probe on an independent command list after Mesa flush. */
+void d3d12_appsandbox_share_submit_postflush(
+   struct d3d12_context *ctx, bool mesa_flush_succeeded);
+
+/* Called after d3d12_flush_cmdlist() submits the list containing the copy. */
+void d3d12_appsandbox_share_publish(struct d3d12_context *ctx);
+
+void d3d12_appsandbox_share_destroy(struct d3d12_context *ctx);
+
+#endif
