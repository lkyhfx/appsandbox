+} // namespace
+
+bool d3d12_appsandbox_share_record(struct d3d12_context *ctx)
+{
+   const char *display = getenv("ASB_D3D12_DISPLAY");
+   const CopyProbeMode requested_mode = copy_probe_mode();
+   const bool needs_consumer =
+      requested_mode == CopyProbeMode::None ||
+      requested_mode == CopyProbeMode::RingOnly ||
+      requested_mode == CopyProbeMode::SharedCopyConsumer;
+   if (!display || strcmp(display, "1") != 0 ||
+       (needs_consumer && access("/run/appsandbox/display-d3d12.sock", F_OK) != 0))
+      return false;
+   void *cbuf_texture = (void *)ctx->fb.cbufs[0].texture;
+   if (cbuf_texture && !hook_logged) {
+      fprintf(stderr, "ASB_D3D12 hook-target has_commands=%d cbuf_texture=%p\\n",
+              ctx->has_commands, cbuf_texture);
+      fflush(stderr);
+      hook_logged = true;
+   } else if (!cbuf_texture && !empty_hook_logged) {
+      fprintf(stderr, "ASB_D3D12 hook-empty has_commands=%d\\n",
+              ctx->has_commands);
+      fflush(stderr);
+      empty_hook_logged = true;
+   }
+   if (!ctx->fb.cbufs[0].texture)
+      return false;
+   auto **state = reinterpret_cast<AppsandboxShare **>(&ctx->appsandbox_share);
+   if (!*state) {
+      *state = new AppsandboxShare();
+      (*state)->probe_mode = requested_mode;
+      if (requested_mode != CopyProbeMode::None)
+         fprintf(stderr, "ASB_D3D12 copy_probe mode=%s stage=begin one_frame=1\n",
+                      copy_probe_mode_name(requested_mode));
+   }
+   struct d3d12_resource *source = d3d12_resource(ctx->fb.cbufs[0].texture);
+   if ((*state)->probe_mode != CopyProbeMode::None)
+      return record_copy_probe(ctx, source, *state);
+   return record_copy(ctx, source, *state);
+}
+
+void d3d12_appsandbox_share_publish(struct d3d12_context *ctx)
+{
+   auto *share = reinterpret_cast<AppsandboxShare *>(ctx->appsandbox_share);
+   if (!share)
+      return;
+   struct d3d12_screen *screen = d3d12_screen(ctx->base.screen);
+   if (share->pending) {
+      if (share->copy_start_ns != 0)
+         share->gpu_copy_us.push_back((now_ns() - share->copy_start_ns) / 1000);
+      const uint64_t value = share->frame + 1;
+      const bool ready_ok =
+         SUCCEEDED(screen->cmdqueue->Signal(share->fence.Get(), value)) &&
+         set_completion(share->fence.Get(), value,
+                        share->slots[share->pending_slot].ready_fd);
+      if (!ready_ok) {
+         debug_printf("ASB_D3D12 blocker=producer-eventfd-sync\n");
+      } else {
+         const uint8_t expected_r = 31U;
+         const uint8_t expected_g = 127U;
+         const uint8_t expected_b = 223U;
+         FrameInfo info = {kMagic, kFrameInfo, share->frame, share->pending_slot,
+                           ((share->frame + 1) % 120) == 0 ? 1U : 0U,
+                           now_ns(),
+                           expected_r, expected_g, expected_b, 255,
+                           1};
+         if (!send_fds(share->socket_fd, &info, sizeof(info), {}))
+            debug_printf("ASB_D3D12 blocker=consumer-control-socket\n");
+         ++share->frame;
+      }
+      share->pending = false;
+   }
+   if (share->diagnostic_pending) {
+      run_diagnostic_fence(ctx, share);
+      share->diagnostic_pending = false;
+   }
+}
+
+void d3d12_appsandbox_share_destroy(struct d3d12_context *ctx)
+{
+   auto *share = reinterpret_cast<AppsandboxShare *>(ctx->appsandbox_share);
+   if (!share)
+      return;
+   debug_printf("gpu_copy_us p50=%.3f p95=%.3f p99=%.3f samples=%zu\n",
+                percentile_us(share->gpu_copy_us, 0.50),
+                percentile_us(share->gpu_copy_us, 0.95),
+                percentile_us(share->gpu_copy_us, 0.99),
+                share->gpu_copy_us.size());
+   debug_printf("slot_recycle_us p50=%.3f p95=%.3f p99=%.3f samples=%zu\n",
+                percentile_us(share->slot_recycle_us, 0.50),
+                percentile_us(share->slot_recycle_us, 0.95),
+                percentile_us(share->slot_recycle_us, 0.99),
+                share->slot_recycle_us.size());
+   debug_printf("ASB_D3D12 source_resource_changes=%llu frames=%llu\n",
+                static_cast<unsigned long long>(share->source_resource_changes),
+                static_cast<unsigned long long>(share->frame));
+   close_fd(share->diagnostic_resource_fd);
+   close_fd(share->diagnostic_event_fd);
+   for (Slot &slot : share->slots) {
+      close_fd(slot.resource_fd);
+      close_fd(slot.ready_fd);
+      close_fd(slot.done_fd);
+   }
+   close_fd(share->socket_fd);
+   delete share;
+   ctx->appsandbox_share = nullptr;
+}
