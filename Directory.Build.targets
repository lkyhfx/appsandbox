<Project>
  <!--
    Auto-embed a VERSIONINFO resource (driven by Directory.Build.props) into every EXE/DLL we
    build, so FileVersion / ProductVersion / CompanyName come from the single source. Each
    binary's OriginalFilename / InternalName / FILETYPE are derived from its own MSBuild
    properties, so individual projects need no edits.

    Opt-out: a project that sets <AsbEmbedVersion>false</AsbEmbedVersion> is skipped (the
    drivers do this - they version via DriverVer/StampInf, not a binary VERSIONINFO). Utility
    projects are skipped automatically by ConfigurationType.

    This file is imported AFTER each project's body, so $(TargetName)/$(TargetFileName)/
    $(ConfigurationType) are already resolved here.
  -->
  <PropertyGroup Condition="'$(AsbEmbedVersion)' == '' And ('$(ConfigurationType)' == 'Application' Or '$(ConfigurationType)' == 'DynamicLibrary')">
    <AsbEmbedVersion>true</AsbEmbedVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AsbEmbedVersion)' == 'true'">
    <AsbFileType Condition="'$(ConfigurationType)' == 'DynamicLibrary'">VFT_DLL</AsbFileType>
    <AsbFileType Condition="'$(AsbFileType)' == ''">VFT_APP</AsbFileType>
  </PropertyGroup>

  <ItemGroup Condition="'$(AsbEmbedVersion)' == 'true'">
    <ResourceCompile Include="$(MSBuildThisFileDirectory)build\version.rc" />
  </ItemGroup>

  <!-- Values are passed UNQUOTED and stringized inside version.rc (avoids quote-escaping
       through MSBuild -> rc.exe). Filenames/versions contain no spaces, so this is safe. -->
  <ItemDefinitionGroup Condition="'$(AsbEmbedVersion)' == 'true'">
    <ResourceCompile>
      <PreprocessorDefinitions>ASB_VERSION_COMMA=$(AsbVersionComma);ASB_VERSION_STR=$(AsbVersion);ASB_ORIG_FILENAME=$(TargetFileName);ASB_INTERNAL_NAME=$(TargetName);ASB_FILE_TYPE=$(AsbFileType);%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
  </ItemDefinitionGroup>

  <!-- Make the version string available to C/C++ sources from the same single source, for
       code that reports it at runtime (e.g. the headless API's /version response). Passed
       UNQUOTED and stringized in the source, mirroring the version.rc injection above. -->
  <PropertyGroup>
    <AsbGeneratedDir Condition="'$(IntDir)' != ''">$(IntDir)generated\</AsbGeneratedDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>ASB_VERSION_SHORT=$(AsbVersionShort);%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories Condition="'$(AsbGeneratedDir)' != ''">$(AsbGeneratedDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>

  <!--
    Bind Host and Guest source provenance at build time. The generated header
    is consumed by asb_core.c when it invokes the repo prefetch mode.
    Release/CI may pass /p:AsbSourceRef=<commit>; otherwise resolve HEAD from
    the checkout. A missing git ref is allowed only for an explicit, noisy
    development fallback to main.
  -->
  <Target Name="GenerateAsbSourceMetadata" BeforeTargets="ClCompile">
    <MakeDir Directories="$(AsbGeneratedDir)" Condition="'$(AsbGeneratedDir)' != ''" />
    <Exec Command="git -C &quot;$(MSBuildThisFileDirectory).&quot; rev-parse HEAD"
          ConsoleToMSBuild="true" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="AsbGitCommitOutput" />
      <Output TaskParameter="ExitCode" PropertyName="AsbGitCommitExitCode" />
    </Exec>
    <Exec Command="git -C &quot;$(MSBuildThisFileDirectory).&quot; diff --quiet HEAD --"
          IgnoreExitCode="true"
          Condition="'$(AsbGitCommitExitCode)' == '0'">
      <Output TaskParameter="ExitCode" PropertyName="AsbGitDirtyExitCode" />
    </Exec>
    <PropertyGroup>
      <AsbSourceRefFromGit>$([System.String]::Copy('$(AsbGitCommitOutput)').Trim())</AsbSourceRefFromGit>
      <AsbSourceRefFromGitIsSha>$([System.Text.RegularExpressions.Regex]::IsMatch('$(AsbSourceRefFromGit)', '^[0-9A-Fa-f]{40}$'))</AsbSourceRefFromGitIsSha>
      <AsbStrictSourceBinding Condition="'$(Configuration)' == 'Release' Or '$(CI)' == 'true' Or '$(CI)' == '1'">true</AsbStrictSourceBinding>
      <AsbGitDirty Condition="'$(AsbGitCommitExitCode)' == '0' And '$(AsbGitDirtyExitCode)' != '0'">true</AsbGitDirty>

      <AsbSourceRef Condition="'$(AsbSourceRef)' == '' And '$(AsbGitCommitExitCode)' == '0' And '$(AsbSourceRefFromGitIsSha)' == 'True'">$(AsbSourceRefFromGit)</AsbSourceRef>
      <AsbSourceRef Condition="'$(AsbSourceRef)' == ''">main</AsbSourceRef>
      <AsbSourceRefFallback Condition="'$(AsbSourceRefWasSupplied)' != 'true' And ('$(AsbGitCommitExitCode)' != '0' Or '$(AsbSourceRefFromGitIsSha)' != 'True')">true</AsbSourceRefFallback>
      <AsbSourceRefIsSha>$([System.Text.RegularExpressions.Regex]::IsMatch('$(AsbSourceRef)', '^[0-9A-Fa-f]{40}$'))</AsbSourceRefIsSha>
    </PropertyGroup>

    <Error Condition="'$(AsbStrictSourceBinding)' == 'true' And '$(AsbSourceRefFallback)' == 'true'"
           Text="ASB source commit unavailable. Release/CI builds require an exact Guest source commit; pass /p:AsbSourceRef=&lt;40-char-commit-sha&gt;." />
    <Warning Condition="'$(AsbStrictSourceBinding)' != 'true' And '$(AsbSourceRefFallback)' == 'true'"
             Text="ASB source commit unavailable; development build is falling back to ref 'main'. Pass /p:AsbSourceRef=&lt;commit&gt; for a reproducible Guest source." />

    <Error Condition="'$(AsbStrictSourceBinding)' == 'true' And '$(AsbSourceRefIsSha)' != 'True'"
           Text="Release/CI builds require AsbSourceRef to be an exact 40-character commit SHA, not a branch or tag." />
    <Warning Condition="'$(AsbStrictSourceBinding)' != 'true' And '$(AsbSourceRefIsSha)' != 'True'"
             Text="ASB Guest source ref '$(AsbSourceRef)' is not an exact commit SHA; this development build is not reproducible." />

    <Error Condition="'$(AsbStrictSourceBinding)' == 'true' And '$(AsbGitDirty)' == 'true' And '$(AsbSourceRefWasSupplied)' != 'true'"
           Text="Working tree is dirty. Release/CI Host binaries must not embed uncommitted code while binding Guest sources to HEAD." />
    <Warning Condition="'$(AsbStrictSourceBinding)' != 'true' And '$(AsbGitDirty)' == 'true' And '$(AsbSourceRefWasSupplied)' != 'true'"
             Text="Working tree is dirty: Host binary may contain uncommitted changes while Guest sources are pinned to HEAD." />
    <ItemGroup>
      <_AsbSourceHeaderLines Include="#ifndef ASB_BUILD_SOURCE_H" />
      <_AsbSourceHeaderLines Include="#define ASB_BUILD_SOURCE_H" />
      <_AsbSourceHeaderLines Include="#define ASB_SOURCE_REPO &quot;$(AsbSourceRepo)&quot;" />
      <_AsbSourceHeaderLines Include="#define ASB_SOURCE_REF &quot;$(AsbSourceRef)&quot;" />
      <_AsbSourceHeaderLines Include="#endif" />
    </ItemGroup>
    <WriteLinesToFile File="$(AsbGeneratedDir)asb_build_source.h"
                      Lines="@(_AsbSourceHeaderLines)"
                      Overwrite="true" />
  </Target>
</Project>
